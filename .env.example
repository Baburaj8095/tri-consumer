# ─── Aqua SMS Gateway Configuration ──────────────────────────────────────────
# Replace with your production Aqua SMS credentials
AQUASMS_APIKEY=your_aquasms_api_key_here
AQUASMS_USERNAME=your_aquasms_username_here
AQUASMS_BASE_URL=http://login.aquasms.com/sendSMS
AQUASMS_SENDERNAME=TRIKNT
AQUASMS_SMSTYPE=TRANS

# ─── OTP Security Settings ───────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_WINDOW_MINUTES=10
OTP_MAX_REQUESTS_PER_WINDOW=5

# ─── Server Configuration ────────────────────────────────────────────────────
SERVER_PORT=8080

